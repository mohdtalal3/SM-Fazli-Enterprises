---
import { Icon } from 'astro-icon/components';
import AddToInquiry from '../ui/AddToInquiry.astro';
import { getSite, productUrl } from '../../lib/data';
import type { Item, Category, Subcategory } from '../../lib/schemas';

interface Props {
  item: Item;
  category: Category;
  subcategory: Subcategory;
  showSub?: boolean;
}

const site = getSite();
const { item, category, subcategory, showSub = true } = Astro.props;
const url = productUrl(category.slug, subcategory.slug, item.slug);
---

<article
  class="card card-hover group flex flex-col overflow-hidden"
  data-product-name={item.name.toLowerCase()}
  data-reveal
>
  <a href={url} class="relative block aspect-[4/3] overflow-hidden bg-gradient-to-br from-steel/25 via-surface to-steel/10">
    {
      item.images.length > 0 ? (
        <img
          src={item.images[0]}
          alt={item.name}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <span class="absolute inset-0 grid place-items-center">
          <span class="grid h-14 w-14 place-items-center rounded-xl bg-card/80 text-accent-600 shadow-card transition-transform duration-300 group-hover:scale-110 dark:text-accent">
            <Icon name={`lucide:${category.icon || 'package'}`} class="h-7 w-7" />
          </span>
        </span>
      )
    }
    {
      item.featured && (
        <span class="absolute top-3 left-3 rounded-full bg-accent px-2 py-0.5 text-[10px] font-bold tracking-wide text-primary uppercase">
          Featured
        </span>
      )
    }
  </a>

  <div class="flex flex-1 flex-col gap-1.5 p-4">
    {
      showSub && (
        <p class="text-[11px] font-semibold tracking-wide text-muted uppercase">{subcategory.name}</p>
      )
    }
    <h3 class="text-[15px] leading-snug font-semibold text-ink">
      <a href={url} class="transition group-hover:text-accent-600 dark:group-hover:text-accent">
        {item.name}
      </a>
    </h3>
    <p class="line-clamp-2 text-xs leading-relaxed text-muted">
      {item.shortDescription || 'Available in standard grades and sizes — request a quote for pricing and lead time.'}
    </p>

    <div class="mt-auto flex items-center justify-between gap-2 pt-3">
      <a
        href={url}
        class="inline-flex items-center gap-1 text-xs font-semibold text-accent-600 transition hover:text-accent dark:text-accent"
      >
        Details
        <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
      </a>
      {
        site.features.inquiryList && (
          <AddToInquiry
            item={{ slug: item.slug, name: item.name, category: category.name, subcategory: subcategory.name, url }}
            variant="sm"
            label="Add"
          />
        )
      }
    </div>
  </div>
</article>
