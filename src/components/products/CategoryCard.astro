---
import { Icon } from 'astro-icon/components';
import type { Category } from '../../lib/schemas';

interface Props {
  category: Category;
  count: number;
  class?: string;
}

const { category, count, class: className = '' } = Astro.props;
---

<a
  href={`/products/${category.slug}`}
  class={`card card-hover group flex flex-col gap-2 p-4 sm:gap-3 sm:p-5 ${className}`}
  data-category-name={(category.name + ' ' + category.description).toLowerCase()}
  data-reveal
>
  <div class="flex items-start justify-between gap-2 sm:gap-3">
    <span
      class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-accent/10 text-accent-600 transition group-hover:bg-accent group-hover:text-primary sm:h-12 sm:w-12 sm:rounded-xl dark:text-accent"
    >
      {category.icon && <Icon name={`lucide:${category.icon}`} class="h-5 w-5 sm:h-6 sm:w-6" />}
    </span>
    <span class="rounded-full border border-line px-2 py-0.5 text-[10px] font-semibold text-muted sm:px-2.5 sm:py-1 sm:text-[11px]">
      {count} {count === 1 ? 'item' : 'items'}
    </span>
  </div>

  <h3 class="text-sm leading-snug font-bold text-ink transition group-hover:text-accent-600 sm:text-base dark:group-hover:text-accent">
    {category.name}
  </h3>
  <p class="hidden line-clamp-2 text-sm leading-relaxed text-muted sm:block">
    {category.description}
  </p>

  <span
    class="mt-auto hidden translate-x-0 items-center gap-1.5 pt-2 text-sm font-semibold text-accent-600 opacity-0 transition group-hover:translate-x-1 group-hover:opacity-100 sm:inline-flex dark:text-accent"
  >
    Browse
    <Icon name="lucide:arrow-right" class="h-4 w-4" />
  </span>
</a>
