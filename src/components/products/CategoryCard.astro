---
import { Icon } from 'astro-icon/components';
import type { Category } from '../../lib/schemas';

interface Props {
  category: Category;
  count: number;
  class?: string;
}

const { category, count, class: className = '' } = Astro.props;
---

<a
  href={`/products/${category.slug}`}
  class={`card card-hover group flex flex-col gap-3 p-5 ${className}`}
  data-category-name={(category.name + ' ' + category.description).toLowerCase()}
  data-reveal
>
  <div class="flex items-start justify-between gap-3">
    <span
      class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent-600 transition group-hover:bg-accent group-hover:text-primary dark:text-accent"
    >
      {category.icon && <Icon name={`lucide:${category.icon}`} class="h-6 w-6" />}
    </span>
    <span class="rounded-full border border-line px-2.5 py-1 text-[11px] font-semibold text-muted">
      {count} {count === 1 ? 'item' : 'items'}
    </span>
  </div>

  <h3 class="text-base font-bold text-ink transition group-hover:text-accent-600 dark:group-hover:text-accent">
    {category.name}
  </h3>
  <p class="line-clamp-2 text-sm leading-relaxed text-muted">{category.description}</p>

  <span
    class="mt-auto inline-flex translate-x-0 items-center gap-1.5 pt-2 text-sm font-semibold text-accent-600 opacity-0 transition group-hover:translate-x-1 group-hover:opacity-100 dark:text-accent"
  >
    Browse
    <Icon name="lucide:arrow-right" class="h-4 w-4" />
  </span>
</a>
