---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, description, align = 'left', class: className = '' } = Astro.props;
const alignCls = align === 'center' ? 'items-center text-center mx-auto' : 'items-start';
---

<div class={`flex max-w-3xl flex-col gap-3 ${alignCls} ${className}`} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl lg:text-[2.1rem]">{title}</h2>
  {description && <p class="text-base leading-relaxed text-muted">{description}</p>}
  <slot />
</div>
