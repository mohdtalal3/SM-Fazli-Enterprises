---
import { Icon } from 'astro-icon/components';
import { publicFileExists } from '../../lib/images';

interface Props {
  src?: string;
  alt: string;
  class?: string;
  icon?: string;
  label?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
}

const { src, alt, class: className = '', icon = 'image', label = '', width, height, loading = 'lazy' } = Astro.props;
const exists = publicFileExists(src);
---

{
  exists ? (
    <img src={src} alt={alt} class={className} width={width} height={height} loading={loading} decoding="async" />
  ) : (
    <div class={`img-placeholder ${className}`} role="img" aria-label={alt}>
      <div class="flex flex-col items-center gap-2 p-4 text-center">
        <Icon name={`lucide:${icon}`} />
        {label && <span class="text-xs font-semibold tracking-wide uppercase opacity-80">{label}</span>}
      </div>
    </div>
  )
}
