---
import { Icon } from 'astro-icon/components';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getCompany } from '../../lib/data';

const items = getCompany().whyChooseUs;
---

{
  items.length > 0 && (
    <section class="py-12 sm:py-16 md:py-24">
      <Container>
        <SectionHeading
          eyebrow="Why Choose Us"
          title="Supply you never have to chase"
          description="Procurement teams stay with Ferrox because we make the boring parts — documentation, lead times, consistency — completely dependable."
        />
        <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
          {items.map((item) => (
            <div class="card card-hover p-4 sm:p-6" data-reveal>
              {item.icon && (
                <span class="grid h-9 w-9 place-items-center rounded-lg bg-accent/10 text-accent-600 sm:h-11 sm:w-11 dark:text-accent">
                  <Icon name={`lucide:${item.icon}`} class="h-5 w-5" />
                </span>
              )}
              <h3 class="mt-3 text-sm leading-snug font-bold text-ink sm:mt-4 sm:text-base">{item.title}</h3>
              <p class="mt-1.5 text-xs leading-relaxed text-muted sm:mt-2 sm:text-sm">{item.description}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>
  )
}
