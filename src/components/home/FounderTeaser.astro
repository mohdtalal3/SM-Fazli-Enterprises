---
import { Icon } from 'astro-icon/components';
import Container from '../ui/Container.astro';
import SmartImage from '../ui/SmartImage.astro';
import { getFounder } from '../../lib/data';

const founder = getFounder();
---

{
  founder && (
    <section class="relative overflow-hidden bg-primary py-16 text-white md:py-20">
      <div class="hex-bg absolute inset-0 opacity-60" aria-hidden="true" />
      <div class="absolute -top-32 left-1/3 h-[360px] w-[360px] rounded-full bg-accent/15 blur-[110px]" aria-hidden="true" />
      <Container class="relative">
        <div class="grid items-center gap-10 lg:grid-cols-[auto_1fr]">
          <div class="mx-auto lg:mx-0" data-reveal>
            <SmartImage
              src={founder.photo}
              alt={founder.name}
              icon="user"
              class="h-40 w-40 rounded-2xl object-cover ring-2 ring-accent/70"
            />
          </div>
          <div data-reveal style="--rd:1">
            <p class="eyebrow text-accent">Leadership</p>
            <blockquote class="mt-4 font-display text-2xl leading-snug font-semibold sm:text-3xl">
              {founder.quote ? `“${founder.quote}”` : founder.shortBio}
            </blockquote>
            <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
              <div>
                <p class="font-semibold">{founder.name}</p>
                <p class="text-sm text-steel">{founder.role}</p>
              </div>
              <a href="/about" class="btn btn-outline-invert btn-sm">
                Meet the team
                <Icon name="lucide:arrow-right" class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>
      </Container>
    </section>
  )
}
