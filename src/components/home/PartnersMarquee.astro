---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getFeaturedPartners } from '../../lib/data';
import { publicFileExists } from '../../lib/images';

const partners = getFeaturedPartners();
---

{
  partners.length > 0 && (
    <section class="border-y border-line bg-card py-14 md:py-16">
      <Container>
        <SectionHeading
          align="center"
          eyebrow="Partners & Clients"
          title="Companies that build with Ferrox"
        />
        <div class="marquee mt-10" data-reveal>
          <div class="marquee-track">
            {[0, 1].map((copy) => (
              <div class="flex gap-4 pr-4" aria-hidden={copy === 1 ? 'true' : undefined}>
                {partners.map((partner) => (
                  <div class="group flex h-16 w-44 shrink-0 items-center justify-center rounded-xl border border-line bg-surface px-4 transition hover:border-accent/50">
                    {publicFileExists(partner.logo) ? (
                      <img
                        src={partner.logo}
                        alt={partner.name}
                        loading="lazy"
                        class="max-h-8 w-auto object-contain opacity-60 grayscale transition group-hover:opacity-100 group-hover:grayscale-0"
                      />
                    ) : (
                      <span class="truncate font-display text-sm font-bold text-muted transition group-hover:text-ink">
                        {partner.name}
                      </span>
                    )}
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )
}
