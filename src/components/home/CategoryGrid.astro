---
import { Icon } from 'astro-icon/components';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import CategoryCard from '../products/CategoryCard.astro';
import { getCategories, countItems } from '../../lib/data';

const categories = getCategories();
---

<section class="py-12 sm:py-16 md:py-24">
  <Container>
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="Product Catalog"
        title="Sixteen categories. One trusted supplier."
        description="From bulk chemicals to precision instruments — browse the full range and add items straight to your inquiry list."
      />
      <a href="/products" class="btn btn-outline" data-reveal style="--rd:2">
        All Products
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3 xl:grid-cols-4">
      {categories.map((category) => <CategoryCard category={category} count={countItems(category)} />)}
    </div>
  </Container>
</section>
