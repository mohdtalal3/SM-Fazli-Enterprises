---
import { Icon } from 'astro-icon/components';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { getTestimonials, getSite } from '../../lib/data';

const site = getSite();
const testimonials = getTestimonials();
---

{
  site.features.testimonials && testimonials.length > 0 && (
    <section class="py-12 sm:py-16 md:py-24">
      <Container>
        <SectionHeading align="center" eyebrow="Testimonials" title="What our clients say" />
        <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
          {testimonials.map((t) => (
            <figure class="card card-hover flex flex-col p-4 sm:p-6" data-reveal>
              <Icon name="lucide:quote" class="h-6 w-6 text-accent sm:h-7 sm:w-7" />
              <blockquote class="mt-3 flex-1 text-xs leading-relaxed text-ink/90 sm:mt-4 sm:text-sm dark:text-ink">
                {t.quote}
              </blockquote>
              <figcaption class="mt-4 border-t border-line pt-3 sm:mt-5 sm:pt-4">
                <p class="text-xs font-semibold text-ink sm:text-sm">{t.author}</p>
                <p class="text-[11px] text-muted sm:text-xs">
                  {[t.role, t.company].filter(Boolean).join(', ')}
                </p>
              </figcaption>
            </figure>
          ))}
        </div>
      </Container>
    </section>
  )
}
