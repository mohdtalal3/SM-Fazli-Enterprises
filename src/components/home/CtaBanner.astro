---
import { Icon } from 'astro-icon/components';
import Container from '../ui/Container.astro';
import { getContact } from '../../lib/data';

const contact = getContact();
---

<section class="pb-20 md:pb-24">
  <Container>
    <div class="relative overflow-hidden rounded-2xl bg-primary px-6 py-14 text-center text-white sm:px-12" data-reveal>
      <div class="hex-bg absolute inset-0 opacity-60" aria-hidden="true" />
      <div class="absolute -top-24 right-1/4 h-72 w-72 rounded-full bg-accent/20 blur-[100px]" aria-hidden="true" />

      <div class="relative mx-auto max-w-2xl">
        <p class="eyebrow justify-center text-accent">Get Started</p>
        <h2 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">Need a bulk quote? Talk to our team.</h2>
        <p class="mt-4 text-base leading-relaxed text-steel-300">
          Send us your list — we reply with pricing, documentation and lead times within one business day.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a href="/quote" class="btn btn-accent btn-lg">
            Request a Quote
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
          </a>
          <a href="/contact" class="btn btn-outline-invert btn-lg">Contact Sales</a>
        </div>
        <p class="mt-6 text-sm text-steel">
          Or call us directly at
          <a href={`tel:${contact.primary.phone.replace(/\s/g, '')}`} class="font-semibold text-accent hover:underline">
            {contact.primary.phone}
          </a>
        </p>
      </div>
    </div>
  </Container>
</section>
