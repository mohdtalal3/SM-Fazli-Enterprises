---
import Container from '../ui/Container.astro';
import { getCompany } from '../../lib/data';

const stats = getCompany().stats;
---

{
  stats.length > 0 && (
    <section class="relative z-10 -mt-10">
      <Container>
        <dl class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
          {stats.map((s, i) => (
            <div class="card p-5 text-center sm:p-6" data-reveal style={`--rd:${i}`}>
              <dd class="font-display text-3xl font-bold text-primary sm:text-4xl dark:text-white">
                <span data-counter={s.value} data-suffix={s.suffix}>
                  {s.value.toLocaleString()}
                  {s.suffix}
                </span>
              </dd>
              <dt class="mt-1.5 text-xs font-medium text-muted sm:text-sm">{s.label}</dt>
            </div>
          ))}
        </dl>
      </Container>
    </section>
  )
}
