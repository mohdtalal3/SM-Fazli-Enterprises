---
import { Icon } from 'astro-icon/components';
---

<div id="search-modal" hidden class="fixed inset-0 z-50 no-print" role="dialog" aria-modal="true" aria-label="Search">
  <div class="absolute inset-0 bg-primary/60 backdrop-blur-sm" data-search-close></div>

  <div class="relative mx-auto mt-[8vh] w-[92%] max-w-xl overflow-hidden rounded-2xl border border-line bg-card shadow-pop">
    <div class="flex items-center gap-3 border-b border-line px-4">
      <Icon name="lucide:search" class="h-5 w-5 shrink-0 text-muted" />
      <input
        id="search-input"
        type="text"
        placeholder="Search products, categories, projects…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search"
        class="w-full bg-transparent py-4 text-sm text-ink outline-none placeholder:text-muted/70"
      />
      <button type="button" class="kbd cursor-pointer" data-search-close aria-label="Close search">ESC</button>
    </div>

    <ul id="search-results" class="max-h-[52vh] overflow-y-auto p-2" role="listbox" aria-label="Search results"></ul>

    <div class="flex items-center justify-between border-t border-line bg-surface px-4 py-2.5 text-[11px] text-muted">
      <span class="inline-flex items-center gap-1.5"><span class="kbd">↑</span><span class="kbd">↓</span> navigate</span>
      <span class="inline-flex items-center gap-1.5"><span class="kbd">↵</span> open</span>
      <span class="hidden items-center gap-1.5 sm:inline-flex"><span class="kbd">Ctrl</span><span class="kbd">K</span> toggle</span>
    </div>
  </div>
</div>

<script>
  import Fuse from 'fuse.js';

  interface SearchEntry {
    type: 'category' | 'subcategory' | 'product' | 'project';
    name: string;
    url: string;
    crumb: string;
  }

  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('search-results');

  if (modal && input && resultsEl) {
    const modalEl: HTMLElement = modal;
    const inputEl: HTMLInputElement = input;
    const results: HTMLElement = resultsEl;
    let fuse: Fuse<SearchEntry> | null = null;
    let allEntries: SearchEntry[] = [];
    let activeIndex = -1;

    const typeLabels: Record<SearchEntry['type'], string> = {
      category: 'Category',
      subcategory: 'Subcategory',
      product: 'Product',
      project: 'Project',
    };

    async function ensureIndex(): Promise<void> {
      if (fuse) return;
      try {
        const res = await fetch('/search-index.json');
        allEntries = (await res.json()) as SearchEntry[];
        fuse = new Fuse(allEntries, {
          keys: [
            { name: 'name', weight: 2 },
            { name: 'crumb', weight: 0.5 },
          ],
          threshold: 0.35,
          ignoreLocation: true,
        });
      } catch {
        allEntries = [];
      }
    }

    const clearActive = () => {
      results.querySelectorAll('a.is-active').forEach((el) => el.classList.remove('is-active'));
    };

    const setActive = (index: number) => {
      const items = results.querySelectorAll<HTMLAnchorElement>('a[data-url]');
      if (!items.length) return;
      activeIndex = ((index % items.length) + items.length) % items.length;
      clearActive();
      const el = items[activeIndex];
      el.classList.add('is-active');
      el.scrollIntoView({ block: 'nearest' });
    };

    function resultItem(entry: SearchEntry): HTMLLIElement {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = entry.url;
      a.dataset.url = entry.url;
      a.className =
        'flex items-center gap-3 rounded-lg px-3 py-2.5 transition hover:bg-surface [&.is-active]:bg-surface [&.is-active]:ring-1 [&.is-active]:ring-accent/50';

      const badge = document.createElement('span');
      badge.textContent = typeLabels[entry.type] ?? entry.type;
      badge.className =
        'min-w-[76px] shrink-0 rounded bg-accent/10 px-1.5 py-0.5 text-center text-[10px] font-bold tracking-wide text-accent-600 uppercase dark:text-accent';

      const text = document.createElement('span');
      text.className = 'min-w-0';
      const name = document.createElement('span');
      name.textContent = entry.name;
      name.className = 'block truncate text-sm font-medium text-ink';
      const crumb = document.createElement('span');
      crumb.textContent = entry.crumb;
      crumb.className = 'block truncate text-xs text-muted';
      text.append(name, crumb);

      const arrow = document.createElement('span');
      arrow.className = 'ml-auto shrink-0 text-muted';
      arrow.textContent = '↵';

      a.append(badge, text, arrow);
      li.appendChild(a);
      return li;
    }

    function render(entries: SearchEntry[], emptyQuery: boolean): void {
      results.innerHTML = '';
      activeIndex = -1;
      if (!entries.length) {
        const empty = document.createElement('li');
        empty.className = 'px-3 py-8 text-center text-sm text-muted';
        empty.textContent = emptyQuery ? 'Type to search the catalog…' : 'No results found. Try a different term.';
        results.appendChild(empty);
        return;
      }
      for (const entry of entries) results.appendChild(resultItem(entry));
    }

    function search(): void {
      const q = inputEl.value.trim();
      if (!q) {
        render(allEntries.filter((e) => e.type === 'category'), true);
        return;
      }
      const matches = fuse ? fuse.search(q).map((r) => r.item).slice(0, 12) : [];
      render(matches, false);
    }

    async function open(prefill = ''): Promise<void> {
      modalEl.hidden = false;
      document.body.style.overflow = 'hidden';
      await ensureIndex();
      inputEl.value = prefill;
      search();
      inputEl.focus();
    }

    function close(): void {
      modalEl.hidden = true;
      document.body.style.overflow = '';
    }

    inputEl.addEventListener('input', search);

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-search-open]')) {
        e.preventDefault();
        const trigger = target.closest<HTMLElement>('[data-search-open]');
        open(trigger?.dataset.query ?? '');
      }
      if (target.closest('[data-search-close]')) close();
    });

    window.addEventListener('search:open', (e) => {
      void open((e as CustomEvent<string>).detail || '');
    });

    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modalEl.hidden) void open();
        else close();
        return;
      }
      if (modalEl.hidden) return;
      if (e.key === 'Escape') {
        close();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(activeIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(activeIndex - 1);
      } else if (e.key === 'Enter') {
        const el = results.querySelector<HTMLAnchorElement>('a.is-active');
        if (el) window.location.href = el.dataset.url ?? el.href;
      }
    });
  }
</script>
