---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { getCompany, getCategories } from '../lib/data';

const company = getCompany();
const categories = getCategories().slice(0, 8);
---

<BaseLayout title={`Page Not Found | ${company.name}`} description="The page you are looking for could not be found.">
  <section class="relative overflow-hidden bg-primary text-white">
    <div class="hex-bg absolute inset-0 opacity-60" aria-hidden="true"></div>
    <Container class="relative flex min-h-[62vh] flex-col items-center justify-center py-20 text-center">
      <p class="font-display text-[5.5rem] leading-none font-bold tracking-tight sm:text-[7rem]">
        4<span class="text-accent">0</span>4
      </p>
      <h1 class="mt-4 font-display text-2xl font-bold sm:text-3xl">This page must have shipped without us.</h1>
      <p class="mt-3 max-w-md text-steel-300">
        The link is broken or the page has moved. Try the catalog search — or head back to solid ground.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <button type="button" class="btn btn-accent" data-search-open>
          <Icon name="lucide:search" class="h-4 w-4" />
          Search the Catalog
        </button>
        <a href="/" class="btn btn-outline-invert">Back to Home</a>
      </div>
    </Container>
  </section>

  <Container class="py-16 text-center">
    <h2 class="text-xs font-bold tracking-[0.18em] text-muted uppercase">Popular Categories</h2>
    <div class="mx-auto mt-5 flex max-w-3xl flex-wrap justify-center gap-2">
      {
        categories.map((category) => (
          <a href={`/products/${category.slug}`} class="chip">
            {category.icon && <Icon name={`lucide:${category.icon}`} class="h-3.5 w-3.5" />}
            {category.menuLabel || category.name}
          </a>
        ))
      }
      <a href="/products" class="chip is-active">
        All Products
        <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </Container>
</BaseLayout>
