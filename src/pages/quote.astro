---
import { Icon } from 'astro-icon/components';
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import { getSite, getCompany, getContact } from '../lib/data';

const site = getSite();
const company = getCompany();
const contact = getContact();

const methods = site.inquiry.method;
const waDigits = site.inquiry.whatsappNumber.replace(/\D/g, '');
---

<PageLayout
  title={`Request a Quote | ${company.name}`} heading="Request a Quote"
  description={`Build your inquiry list and request a consolidated quote from ${company.name} — via WhatsApp, email or our team.`}
  breadcrumbs={[{ name: 'Request a Quote' }]}
  eyebrow="Inquiry List"
  lead="Add items from anywhere on the site, then send us one consolidated request. We reply with pricing, documentation and lead times within one business day."
>
  <Container>
    <div class="grid items-start gap-8 lg:grid-cols-[1.2fr_1fr]">
      <!-- Inquiry items -->
      <section class="card p-5 sm:p-6" data-reveal>
        <div class="flex items-center justify-between gap-3">
          <h2 class="font-display text-lg font-bold text-ink">
            Your items <span class="ml-1 text-sm font-medium text-muted" id="inquiry-count"></span>
          </h2>
          <button type="button" id="inquiry-clear" class="inline-flex items-center gap-1.5 text-xs font-semibold text-muted transition hover:text-red-500" hidden>
            <Icon name="lucide:trash-2" class="h-3.5 w-3.5" />
            Clear all
          </button>
        </div>

        <div id="inquiry-items" class="mt-4 space-y-2.5"></div>

        <div id="inquiry-empty" class="py-14 text-center">
          <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-accent/10 text-accent-600 dark:text-accent">
            <Icon name="lucide:clipboard-list" class="h-7 w-7" />
          </span>
          <p class="mt-4 font-semibold text-ink">Your inquiry list is empty</p>
          <p class="mx-auto mt-1.5 max-w-xs text-sm text-muted">
            Browse the catalog and use “Add to Inquiry” on any product to build your request.
          </p>
          <a href="/products" class="btn btn-primary mt-6">Browse Products</a>
        </div>
      </section>

      <!-- Contact form -->
      <section class="card p-5 sm:p-6" data-reveal style="--rd:1">
        <h2 class="font-display text-lg font-bold text-ink">Your details</h2>
        <p class="mt-1 text-sm text-muted">Tell us who you are — we reply within one business day.</p>

        <form id="quote-form" class="mt-5 space-y-4" novalidate>
          <div class="grid grid-cols-2 gap-3 sm:gap-4">
            <div>
              <label for="q-name" class="label">Name *</label>
              <input id="q-name" name="name" type="text" required class="input" placeholder="Your full name" autocomplete="name" />
            </div>
            <div>
              <label for="q-company" class="label">Company</label>
              <input id="q-company" name="company" type="text" class="input" placeholder="Company name" autocomplete="organization" />
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:gap-4">
            <div>
              <label for="q-phone" class="label">Phone</label>
              <input id="q-phone" name="phone" type="tel" class="input" placeholder="+92 3xx xxxxxxx" autocomplete="tel" />
            </div>
            <div>
              <label for="q-email" class="label">Email</label>
              <input id="q-email" name="email" type="email" class="input" placeholder="you@company.com" autocomplete="email" />
            </div>
          </div>
          <div>
            <label for="q-message" class="label">Message</label>
            <textarea id="q-message" name="message" rows="4" class="input resize-y" placeholder="Quantities, grades, delivery location or any special requirements…"></textarea>
          </div>

          <div class="space-y-2.5 pt-1" id="form-buttons">
            {
              methods.includes('whatsapp') && waDigits && (
                <button type="submit" class="btn btn-whatsapp w-full" data-method="whatsapp">
                  <Icon name="whatsapp" class="h-4 w-4" />
                  Send via WhatsApp
                </button>
              )
            }
            {
              methods.includes('email') && site.inquiry.email && (
                <button type="submit" class="btn btn-primary w-full" data-method="email">
                  <Icon name="lucide:mail" class="h-4 w-4" />
                  Send via Email
                </button>
              )
            }
            {
              methods.includes('endpoint') && site.inquiry.formEndpoint && (
                <button type="submit" class="btn btn-accent w-full" data-method="endpoint">
                  <Icon name="lucide:send" class="h-4 w-4" />
                  Submit Request
                </button>
              )
            }
          </div>

          <p id="form-status" class="hidden rounded-lg px-3.5 py-2.5 text-sm" role="status"></p>
          <p class="text-xs leading-relaxed text-muted">
            Your inquiry list lives in your browser (localStorage) — nothing is sent until you submit. Prefer talking?
            Call
            <a href={`tel:${contact.primary.phone.replace(/\s/g, '')}`} class="font-semibold text-accent-600 hover:underline dark:text-accent">
              {contact.primary.phone}
            </a>.
          </p>
        </form>
      </section>
    </div>
  </Container>
</PageLayout>

<script>
  import {
    getInquiry,
    removeInquiryItem,
    setInquiryQty,
    clearInquiry,
    buildWhatsAppLink,
    buildInquiryMessage,
    type InquiryItem,
  } from '../lib/inquiry';

  const listEl = document.getElementById('inquiry-items');
  const emptyEl = document.getElementById('inquiry-empty');
  const countEl = document.getElementById('inquiry-count');
  const clearBtn = document.getElementById('inquiry-clear');
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');

  const esc = (s: string): string => {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  };

  function render(): InquiryItem[] {
    const items = getInquiry();
    if (!listEl || !emptyEl || !countEl || !clearBtn) return items;

    countEl.textContent = items.length ? `(${items.length})` : '';
    clearBtn.hidden = items.length === 0;
    emptyEl.hidden = items.length > 0;
    listEl.innerHTML = '';

    for (const item of items) {
        const row = document.createElement('div');
        row.className = 'flex items-center gap-3 rounded-lg border border-line bg-surface/60 p-3';
        row.innerHTML = `
          <div class="min-w-0 flex-1">
            <a href="${esc(item.url)}" class="block truncate text-sm font-semibold text-ink hover:text-accent">${esc(item.name)}</a>
            <p class="truncate text-xs text-muted">${esc(item.category)} › ${esc(item.subcategory)}</p>
          </div>
          <label class="flex items-center gap-1.5 text-xs text-muted">
            Qty
            <input type="number" min="1" step="1" value="${item.qty}" data-qty="${esc(item.slug)}" class="input w-16 px-2 py-1.5 text-center" aria-label="Quantity for ${esc(item.name)}" />
          </label>
          <button type="button" data-remove="${esc(item.slug)}" class="grid h-8 w-8 shrink-0 cursor-pointer place-items-center rounded-md border border-line text-muted transition hover:border-red-300 hover:text-red-500" aria-label="Remove ${esc(item.name)}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          </button>
        `;
        listEl.appendChild(row);
    }
    return items;
  }
  listEl?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.matches('[data-qty]')) {
      const slug = target.dataset.qty ?? '';
      setInquiryQty(slug, Number(target.value));
      render();
    }
  });

  listEl?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLElement>('[data-remove]');
    if (btn) {
      removeInquiryItem(btn.dataset.remove ?? '');
      render();
    }
  });

  clearBtn?.addEventListener('click', () => {
    clearInquiry();
    render();
  });

  /* URL params: ?add=<slug> and ?category=<slug> */
  async function handleParams(): Promise<void> {
    const params = new URLSearchParams(window.location.search);
    const addSlug = params.get('add');
    const catSlug = params.get('category');

    if (addSlug) {
      try {
        const res = await fetch('/search-index.json');
        const index = (await res.json()) as { type: string; name: string; url: string; crumb: string }[];
        const entry = index.find((e) => e.type === 'product' && e.url.endsWith(`/${addSlug}`));
        if (entry) {
          const [category, subcategory] = entry.crumb.split(' › ');
          const items = getInquiry();
          if (!items.some((i) => i.url === entry.url)) {
            items.push({ slug: addSlug, name: entry.name, category: category ?? '', subcategory: subcategory ?? '', url: entry.url, qty: 1 });
            window.localStorage.setItem('ferrox-inquiry-v1', JSON.stringify(items));
            window.dispatchEvent(new CustomEvent('inquiry:changed', { detail: { count: items.length } }));
          }
        }
      } catch {
        /* index unavailable — skip prefill */
      }
      window.history.replaceState({}, '', '/quote');
    }

    if (catSlug) {
      const message = document.getElementById('q-message') as HTMLTextAreaElement | null;
      if (message && !message.value) {
        message.value = `We are looking for pricing on your ${catSlug.replace(/-/g, ' ')} range.`;
      }
      window.history.replaceState({}, '', '/quote');
    }

    render();
  }

  void handleParams();
  window.addEventListener('inquiry:changed', () => void render());

  /* Submit */
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!statusEl) return;

    const get = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() ?? '';
    const meta = {
      name: get('q-name'),
      company: get('q-company'),
      phone: get('q-phone'),
      email: get('q-email'),
      message: get('q-message'),
    };

    const items = getInquiry();

    const showStatus = (text: string, ok: boolean) => {
      statusEl.textContent = text;
      statusEl.className = `rounded-lg px-3.5 py-2.5 text-sm ${
        ok ? 'bg-green-500/10 text-green-700 dark:text-green-400' : 'bg-red-500/10 text-red-600 dark:text-red-400'
      }`;
      statusEl.hidden = false;
    };

    if (!meta.name) return showStatus('Please add your name.', false);
    if (!meta.phone && !meta.email) return showStatus('Please add a phone number or an email so we can reply.', false);
    if (items.length === 0 && !meta.message) return showStatus('Your list is empty — add items or write a message instead.', false);

    const method = (e.submitter as HTMLElement | null)?.dataset.method ?? 'email';
    const message = buildInquiryMessage(items, meta);

    if (method === 'whatsapp') {
      const number = form?.dataset.whatsapp ?? '';
      window.open(buildWhatsAppLink(number, message), '_blank', 'noopener');
      showStatus('Opening WhatsApp with your inquiry… If nothing happens, check your pop-up blocker.', true);
    } else if (method === 'email') {
      const email = form?.dataset.email ?? '';
      window.location.href = `mailto:${email}?subject=${encodeURIComponent('Quote request — ' + meta.company || meta.name)}&body=${encodeURIComponent(message)}`;
      showStatus('Opening your email client with the inquiry prefilled…', true);
    } else if (method === 'endpoint') {
      const endpoint = form?.dataset.endpoint ?? '';
      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ ...meta, items }),
      })
        .then(() => showStatus('Request sent — we will get back to you within one business day.', true))
        .catch(() => showStatus('Something went wrong. Please try again or use WhatsApp.', false));
    }

    clearInquiry();
    render();
  });

  render();
</script>
